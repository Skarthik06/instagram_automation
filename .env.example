# Copy to `.env` and fill in. NEVER commit the real .env.
# Only the LLM key + hosting config live here.
# Instagram account credentials and the News API key are managed in the
# app's Settings panel (stored in the "rags" SQLite store, not in this file).

# --- LLM (required) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Safety ceiling on generated tokens per batch (cost guard).
LLM_MAX_OUTPUT_TOKENS=2200

# --- Database (PostgreSQL) ---
# In Docker this is injected by docker-compose (points at the `db` service).
# For LOCAL (non-Docker) dev against your own Postgres, set it here instead.
# DATABASE_URL=postgresql://instagram:instagram@localhost:5432/instagram_business

# --- Public image hosting (GitHub raw) ---
# Images are committed to this PUBLIC repo so Instagram can fetch them by URL.
GITHUB_USERNAME=your-github-username
GITHUB_REPO=instagram_automation
GITHUB_BRANCH=main

# --- Single-admin login (private app — ONE administrator, no SaaS/RBAC) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
ADMIN_SECRET=set-a-long-random-string-here

# --- Optional ---
IG_HANDLE=sparkle06.exe
