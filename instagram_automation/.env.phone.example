# Business-SK PHONE server env (Option A). Copy to .env inside proot Ubuntu and fill in.
# NEVER commit the real .env — it is git-ignored. The .ragskey file must be copied
# separately (securely) to /root/business-sk/instagram_automation/.ragskey.

# --- Database (local Postgres ON THE PHONE; this is the always-on source of truth) ---
DATABASE_URL=postgresql://instagram:CHANGE_ME@localhost:5432/instagram_business

# --- Engagement behaviour ---
ENGAGEMENT_LIVE=1                 # 1 = actually reply/DM; 0 = dry-run (log only)
ENGAGEMENT_AUTO_SYNC=0            # 0 = webhooks only (recommended). 1 = also fallback-poll.
ENGAGEMENT_SYNC_INTERVAL=300      # only used if AUTO_SYNC=1 (seconds; keep large = light)

# --- Meta webhook verification ---
META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_random_string   # must match the Meta webhook config
META_APP_SECRET=CHANGE_ME_from_meta_app_settings    # verifies X-Hub-Signature-256

# --- Storefront link shown in the DM product cards ("See All Products") ---
GITHUB_USERNAME=skarthik06
GITHUB_REPO=business-sk

# --- Optional: only if any rule uses AI-rephrased replies (grounded) ---
OPENAI_API_KEY=
